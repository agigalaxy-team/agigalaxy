{
  "version": 1,
  "components": [
    {
      "id": "contracts",
      "kind": "library",
      "roots": [
        "packages/galaxy-official/src/shared"
      ],
      "files": [
        "packages/galaxy-official/src/browser-client.mjs",
        "packages/galaxy-official/src/operations-permission-catalog.mjs"
      ],
      "dependsOn": [],
      "build": [],
      "checks": [
        [
          "{node}",
          "--test",
          "packages/galaxy-official/test/task-enrollment-v2.test.mjs"
        ]
      ]
    },
    {
      "id": "core",
      "kind": "library",
      "roots": [
        "packages/galaxy-core"
      ],
      "dependsOn": [],
      "build": [],
      "checks": [
        [
          "{node}",
          "scripts/check.mjs",
          "core"
        ]
      ]
    },
    {
      "id": "mail",
      "kind": "library",
      "roots": [
        "packages/galaxy-mail"
      ],
      "dependsOn": [],
      "build": [],
      "checks": []
    },
    {
      "id": "hub",
      "kind": "service-family",
      "roots": [
        "packages/galaxy-official"
      ],
      "dependsOn": [
        "contracts",
        "core",
        "mail"
      ],
      "entries": {
        "api": "packages/galaxy-official/src/server.mjs",
        "worker": "packages/galaxy-official/src/worker.mjs",
        "migration": "packages/galaxy-official/src/migrate.mjs",
        "publisher": "packages/galaxy-official/src/content-publisher.mjs"
      },
      "build": [
        [
          "{node}",
          "packages/galaxy-official/scripts/service-release.mjs",
          "capture",
          "{output}",
          "local-review",
          "local-review",
          "{receipt}"
        ]
      ],
      "checks": [
        [
          "{node}",
          "--test",
          "packages/galaxy-official/test/operations-auth-root-lifecycle.test.mjs",
          "packages/galaxy-official/test/task-fact-client-v2.test.mjs"
        ]
      ]
    },
    {
      "id": "native-client",
      "kind": "client",
      "roots": [
        "packages/galaxy-node",
        "packages/galaxy-edge-mcp",
        "integrations/native-v2",
        "integrations/host-adapters"
      ],
      "dependsOn": [
        "core",
        "contracts"
      ],
      "build": [
        [
          "{node}",
          "integrations/native-v2/compact-app/build.mjs"
        ],
        [
          "{node}",
          "scripts/build-native-v2.mjs",
          "{output}"
        ]
      ],
      "checks": [
        [
          "{node}",
          "--test",
          "integrations/native-v2/setup.test.mjs",
          "integrations/host-adapters/opencode-stable/native-runtime-bridge.test.mjs"
        ]
      ],
      "buildLimit": "Unsigned local source candidate. Dependency installation, license inventory and physical host acceptance remain separate."
    },
    {
      "id": "a2a",
      "kind": "client",
      "roots": [
        "packages/galaxy-a2a"
      ],
      "dependsOn": [
        "core",
        "contracts",
        "native-client"
      ],
      "build": [],
      "checks": [
        [
          "{node}",
          "scripts/check.mjs",
          "a2a"
        ]
      ]
    },
    {
      "id": "web",
      "kind": "frontend",
      "roots": [
        "packages/galaxy-web",
        "components",
        "hooks",
        "lib"
      ],
      "dependsOn": [
        "contracts",
        "core",
        "native-client"
      ],
      "build": [
        [
          "{node}",
          "node_modules/vite/bin/vite.js",
          "build",
          "--config",
          "packages/galaxy-web/vite.config.mjs",
          "--configLoader",
          "native",
          "--outDir",
          "{output}"
        ]
      ],
      "checks": [
        [
          "{node}",
          "--test",
          "packages/galaxy-official/test/task-owner-control-client-continuity.test.mjs"
        ]
      ]
    },
    {
      "id": "site",
      "kind": "frontend",
      "roots": [
        "apps/galaxy-site",
        "public",
        "app"
      ],
      "dependsOn": [
        "web",
        "contracts"
      ],
      "build": [
        [
          "{node}",
          "scripts/build-product.mjs",
          "--site-only",
          "--web-dist",
          "{webOutput}",
          "--output",
          "{output}"
        ]
      ],
      "checks": []
    },
    {
      "id": "auth",
      "kind": "frontend",
      "roots": [
        "apps/galaxy-auth"
      ],
      "dependsOn": [
        "mail",
        "web"
      ],
      "build": [
        [
          "{node}",
          "apps/galaxy-auth/build.mjs",
          "--out",
          "{output}"
        ]
      ],
      "checks": [
        [
          "{node}",
          "--test",
          "apps/galaxy-auth/shared/galaxy-auth.test.mjs"
        ]
      ]
    },
    {
      "id": "admin",
      "kind": "frontend",
      "roots": [
        "apps/galaxy-admin"
      ],
      "dependsOn": [
        "contracts"
      ],
      "cwd": "apps/galaxy-admin",
      "build": [
        [
          "{node}",
          "node_modules/next/dist/bin/next",
          "build"
        ]
      ],
      "checks": []
    },
    {
      "id": "agentos",
      "kind": "service",
      "roots": [
        "services/galaxy-operations-agentos"
      ],
      "dependsOn": [],
      "interfaces": [
        "Node authority HTTP/service-key + JWT",
        "Native AgentOS private HTTP/SSE"
      ],
      "build": [
        [
          "{python}",
          "scripts/compile-python-source.py",
          "services/galaxy-operations-agentos/src",
          "{output}"
        ]
      ],
      "buildLimit": "Python source compilation; Docker image and persistence checks are separate.",
      "checks": [
        [
          "{python}",
          "-m",
          "unittest",
          "discover",
          "-s",
          "services/galaxy-operations-agentos/tests",
          "-p",
          "test_database_contract.py",
          "-v"
        ]
      ]
    },
    {
      "id": "model-gateway",
      "kind": "service",
      "roots": [
        "services/galaxy-model-gateway"
      ],
      "dependsOn": [],
      "interfaces": [
        "OpenAI/Anthropic/Ollama compatible private HTTP",
        "Node model-setting apply/readback"
      ],
      "build": [
        [
          "{python}",
          "scripts/compile-python-source.py",
          "services/galaxy-model-gateway/src",
          "{output}"
        ]
      ],
      "buildLimit": "Python source compilation; pinned upstream download and Docker build are separate.",
      "checks": []
    },
    {
      "id": "discovery",
      "kind": "service-adapter",
      "roots": [
        "services/galaxy-discovery"
      ],
      "dependsOn": [],
      "build": [],
      "checks": [
        [
          "{node}",
          "--test",
          "services/galaxy-discovery/test/gorse-gateway-pagination.test.mjs"
        ]
      ]
    }
  ],
  "globalInputs": [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "repository-components.json",
    "scripts/components.mjs",
    "scripts/compile-python-source.py",
    "scripts/build-product.mjs",
    "scripts/create-release-baseline.py",
    ".github/workflows/product-checks.yml"
  ],
  "sourceRoots": [
    "apps",
    "services",
    "packages",
    "integrations",
    "scripts",
    "docs",
    "public",
    "components",
    "hooks",
    "lib",
    "app",
    "examples",
    "test",
    "tools",
