<clickhouse>
  <listen_host>0.0.0.0</listen_host>
  <logger><level>error</level><console>true</console></logger>
  <max_server_memory_usage_to_ram_ratio>0.25</max_server_memory_usage_to_ram_ratio>
  <query_thread_log remove="remove"/><query_log remove="remove"/>
  <text_log remove="remove"/><trace_log remove="remove"/>
  <metric_log remove="remove"/><asynchronous_metric_log remove="remove"/>
  <session_log remove="remove"/><part_log remove="remove"/>
  <interserver_listen_host>0.0.0.0</interserver_listen_host>
  <interserver_http_host>op-ch</interserver_http_host>
  <macros><shard>1</shard><replica>replica1</replica><cluster>openpanel_cluster</cluster></macros>
</clickhouse>
