# Select actual paths, service account and unused loopback port before deployment.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=5179
GALAXY_WEB_CONFIG_FILE=/etc/galaxy/website-public.json
# start.mjs defaults both content roots to its own immutable runtime directory.
# Override GALAXY_SITE_BASELINE_ROOT / GALAXY_SITE_PUBLIC_ROOT only for an explicit separate content store.
# Set only after preparing an explicit baseline marker or a real publication.
# GALAXY_SITE_CONTENT_ROOT=/var/lib/galaxy/website-content/current
