    "build:site": "node scripts/build-product.mjs --site-only",
    "build:demo": "vinext build",
    "start:demo": "wrangler dev --config dist/server/wrangler.json",
    "setup": "node scripts/setup-development.mjs",
    "docs:check": "node scripts/check-requirements.mjs",
    "docs:public": "python tools/sync_public_docs.py",
    "build:browser-client": "vite build --config packages/galaxy-web/vite.config.mjs",
