    "mcp": "node scripts/hub-runtime.mjs integration-mcp",
    "integration:mcp": "node scripts/hub-runtime.mjs integration-mcp",
    "test": "node scripts/check.mjs test",
    "lint": "node scripts/check.mjs lint",
    "format": "oxfmt",
    "test:core": "node scripts/check.mjs core",
    "test:official": "node scripts/check.mjs official",
    "test:a2a": "node scripts/check.mjs a2a",
    "test:conformance": "node scripts/run-conformance.mjs",
