{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "galaxy": {
      "type": "local",
      "command": ["node", "C:/path/to/galaxy/scripts/hub-runtime.mjs", "native"],
      "environment": {
        "GALAXY_NATIVE_CONFIG": "C:/path/to/selected-public-native-config.json",
        "GALAXY_NATIVE_EXECUTABLE": "C:/path/to/galaxy.exe"
      },
      "enabled": true,
      "timeout": 10000
    }
  }
}
