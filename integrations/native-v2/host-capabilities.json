{
  "schemaVersion": 1,
  "common": {
    "runtime": "galaxy-go-native",
    "mcpPackage": "github.com/modelcontextprotocol/go-sdk v1.8.0",
    "browserFallback": "temporary-loopback-user-review",
    "modelProvider": "user-host",
    "acceptanceScope": "Host configuration formats and source adapters; not runtime acceptance."
  },
  "hosts": [
    {
      "id": "opencode",
      "product": "OpenCode",
      "modes": [
        "terminal TUI",
        "Agent MCP"
      ],
      "config": "opencode/opencode.json",
      "tui": "opencode/tui.json",
      "skill": "opencode/.agents/skills/galaxy",
      "formatEvidence": "official-document-and-generated-local-configuration",
      "sources": [
        "https://opencode.ai/docs/config/",
        "https://opencode.ai/docs/mcp-servers/",
        "https://opencode.ai/docs/skills/"
      ],
      "note": "The ordinary Native plugin is loaded from the installed package. Existing providers remain host-owned. Current installed-process and virtual-headless evidence must be recorded separately from protocol tests."
    },
    {
      "id": "claude-code",
      "product": "Claude Code",
      "modes": [
        "CLI",
        "IDE chat",
        "Desktop local Code tab"
      ],
      "config": "claude-code/.mcp.json",
      "skill": "claude-code/.claude/skills/galaxy",
      "formatEvidence": "official-document",
      "sources": [
        "https://code.claude.com/docs/en/mcp",
        "https://code.claude.com/docs/en/desktop",
        "https://code.claude.com/docs/en/skills",
        "https://code.claude.com/docs/en/hooks"
      ],
      "note": "Desktop Chat config can also feed local Code sessions; CLI does not read Desktop Chat config.",
      "observationAdapter": {
        "source": "host-adapters/claude-code/hook.mjs",
        "status": "source-implemented",
        "events": [
          "UserPromptSubmit",
          "PostToolUse",
          "Stop",
          "PostToolUseFailure"
        ],
        "scope": "Host hook facts and exact selected transcript only; no directory scan or chat injection. The current Agent organizes work through MCP."
      }
    },
    {
      "id": "github-copilot",
      "product": "GitHub Copilot",
      "modes": [
        "VS Code Agent chat"
      ],
      "config": "copilot-vscode/.vscode/mcp.json",
      "skill": "copilot-vscode/.github/skills/galaxy",
      "formatEvidence": "official-document",
      "sources": [
        "https://docs.github.com/en/copilot/how-tos/provide-context/use-mcp-in-your-ide/extend-copilot-chat-with-mcp",
        "https://docs.github.com/en/copilot/concepts/agents/about-agent-skills"
      ],
      "note": "This emitted wrapper targets VS Code; other Copilot modes are separate acceptance scopes."
    },
    {
      "id": "codex",
      "product": "Codex",
      "modes": [
        "CLI",
        "IDE chat",
        "Desktop local task"
      ],
      "config": "codex/config.fragment.toml",
      "plugin": "codex/galaxy-native-v2",
      "skill": "codex/.agents/skills/galaxy",
      "formatEvidence": "official-document-and-plugin-scaffold-validator",
      "sources": [
        "https://developers.openai.com/codex/mcp",
        "https://developers.openai.com/codex/skills",
        "https://learn.chatgpt.com/docs/hooks"
      ],
      "note": "Use plugin or direct MCP + Skill once; do not install both as duplicate servers.",
      "observationAdapter": {
        "source": "host-adapters/codex/hook.mjs",
        "status": "source-implemented",
        "events": [
          "UserPromptSubmit",
          "PostToolUse",
          "Stop"
        ],
        "scope": "Host hook facts and exact selected transcript only; no directory scan or chat injection. The current Agent organizes work through MCP."
      }
    },
    {
      "id": "cursor",
      "product": "Cursor",
      "modes": [
        "local Agent chat"
      ],
      "config": "cursor/.cursor/mcp.json",
      "skill": "cursor/.cursor/skills/galaxy",
      "formatEvidence": "official-document",
      "sources": [
        "https://prod.cursor.com/docs/mcp",
        "https://prod.cursor.com/docs/skills"
      ],
      "note": "MCP Apps/elicitation documentation is not Galaxy embedded UI acceptance."
    },
    {
      "id": "workbuddy",
      "product": "WorkBuddy",
      "modes": [
        "desktop connector"
      ],
      "config": "workbuddy/galaxy-native-v2/mcp.json",
      "skill": "workbuddy/galaxy-native-v2/skills/galaxy",
      "formatEvidence": "official-document",
      "minimumMetadataVersion": "4.24.0",
      "sources": [
        "https://open.workbuddy.cn/docs/connector"
      ],
      "note": "Generated absolute paths target local review. Marketplace distribution and globally unique source registration remain separate."
    },
    {
      "id": "trae-desktop",
      "product": "TRAE / TraeWork",
      "modes": [
        "desktop local tasks"
      ],
      "config": "trae-work/mcp.local.json",
      "skill": "trae-work/.trae/skills/galaxy",
      "formatEvidence": "official-document",
      "sources": [
        "https://docs.trae.cn/work_mcp-overview",
        "https://docs.trae.cn/work_remote-mcp-server",
        "https://docs.trae.cn/work_skills"
      ],
      "note": "Select local, not cloud. Official command field forbids spaces: node must resolve in host PATH or use a verified path without spaces. Docs retrieved using requested model-name User-Agent."
    },
    {
      "id": "hermes",
      "product": "Hermes Agent",
      "modes": [
        "chat"
      ],
      "config": "hermes/config.fragment.yaml",
      "skill": "hermes/skills/galaxy",
      "formatEvidence": "official-public-document",
      "sources": [
        "https://hermes-agent.nousresearch.com/docs/user-guide/features/mcp",
        "https://hermes-agent.nousresearch.com/docs/guides/work-with-skills",
        "https://github.com/NousResearch/hermes-agent/blob/81567c33e9997fbd4eb26a23f289e47f3eba777e/website/docs/user-guide/features/hooks.md"
      ],
      "note": "Uses the selected Hermes profile. Installation and full application runtime acceptance remain separate from adapter integration.",
      "observationAdapter": {
        "source": "host-adapters/hermes",
        "status": "source-implemented",
        "events": [
          "pre_llm_call",
          "post_llm_call",
          "post_tool_call",
          "on_session_end"
        ],
        "scope": "Python plugin records host facts; explicitly selected original messages are read from the exact official SessionDB session. The current Agent organizes work through MCP."
      }
    },
    {
      "id": "deepseek-harness",
      "product": "DeepSeek Harness",
      "modes": [
        "local Harness web/chat"
      ],
      "config": "deepseek-harness/mcp-plugin.fragment.json",
      "skill": "deepseek-harness/.dsh/skills/galaxy",
      "formatEvidence": "official-repository-master",
      "sources": [
        "https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/mcp/mcp-client/README.md",
        "https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/skill/skill-filesystem/README.md",
        "https://github.com/deepseek-ai/deepseek-harness/blob/ce7073d51254c26cd63b22a60835b8f948deb447/docs/subsystems/session.md"
      ],
      "note": "Append MCP plugin to actual config composition; reuse existing Skill registry/filesystem/consumer. Floating panel not implemented by this wrapper.",
      "observationAdapter": {
        "source": "host-adapters/deepseek-harness/index.mjs",
        "status": "source-implemented",
        "events": [
          "session/event"
        ],
        "scope": "Post-commit live observations with source cursor recovery where sessionQuery is available. The current Agent can organize pending work through MCP."
      }
    },
    {
      "id": "github-copilot-cli",
      "product": "GitHub Copilot CLI",
      "modes": [
        "CLI"
      ],
      "note": "Independent of GitHub Copilot in VS Code; configuration and runtime must be verified separately."
    }
  ],
  "updatedAt": "2026-11-03"
}
