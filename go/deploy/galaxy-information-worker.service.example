# Substitute the immutable release path and existing process identity/env.
# Retain the installed unit's actual LoadCredential and filesystem grants.
[Unit]
Description=Galaxy Go information-worker
After=network.target

[Service]
Type=simple
User=galaxy
Group=galaxy
WorkingDirectory=/opt/galaxy
EnvironmentFile=/etc/galaxy/information-worker.env
Environment=GALAXY_RUNTIME_LOG_INSTANCE=information
ExecStart=/opt/galaxy/releases/go-REPLACE_VERSION/galaxy-information-worker
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=multi-user.target
