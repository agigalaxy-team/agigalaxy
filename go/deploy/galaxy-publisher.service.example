# Substitute the immutable release path and existing process identity/env.
# Retain the installed unit's actual LoadCredential and filesystem grants.
[Unit]
Description=Galaxy Go publisher
After=network.target

[Service]
Type=simple
User=galaxy
Group=galaxy
WorkingDirectory=/opt/galaxy
EnvironmentFile=/etc/galaxy/publisher.env
Environment=GALAXY_RUNTIME_LOG_INSTANCE=primary
ExecStart=/opt/galaxy/releases/go-REPLACE_VERSION/galaxy-publisher
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=multi-user.target
