# References only. Replace placeholders in an independently protected file.
# Never source the API environment wholesale: no admin/account cookie secrets,
# GALAXY_SIGNING_KEY_FILE or GALAXY_SIGNING_KEY_ID are needed by this process.
GALAXY_INFORMATION_SOURCE_DATABASE_URL=<protected API-role PostgreSQL connection>
GALAXY_INFORMATION_TRANSPORT_DATABASE_URL=<protected Worker-role connection to the same database>
GALAXY_ENDPOINT=https://your-approved-endpoint.example
GALAXY_ROOT_PINS_FILE=/etc/galaxy/public-root-pins.json
GALAXY_KEYRING_FILE=/etc/galaxy/public-keyring.json
GALAXY_TRUST_DIRECTORY=/var/lib/galaxy/information-trust
GALAXY_ENVIRONMENT=local
GALAXY_RUNTIME_LOG_DIRECTORY=/var/log/galaxy
GALAXY_RUNTIME_LOG_INSTANCE=information
# Reuse existing protected schema-valid source configuration files as needed.
# Identity provider metadata loading does not resolve clientSecretEnv values.
# GALAXY_IDENTITY_CONFIG_FILE=/etc/galaxy/identity.json
# GALAXY_RETIREMENT_FILE=/etc/galaxy/retirement.json
# GALAXY_INCIDENT_FILE=/etc/galaxy/incident.json
# GALAXY_RESOURCE_BUDGET_FILE=/etc/galaxy/resource-budget.json
# GALAXY_FORUM_POLICY_FILE=/etc/galaxy/forum-policy.json
# GALAXY_COMMUNITY_QUOTA_FILE=/etc/galaxy/community-quota.json
# GALAXY_GOVERNANCE_CONFIG=/etc/galaxy/governance.json
# GALAXY_GOVERNANCE_REVIEW_FILE=/etc/galaxy/governance-review.json
# GALAXY_GOVERNANCE_AUTHORITIES_FILE=/etc/galaxy/governance-authorities.json
# GALAXY_EXTERNAL_CREDENTIALS_CONFIG_FILE=/etc/galaxy/external-credentials.json
# GALAXY_ATTACHMENTS_CONFIG_FILE=/etc/galaxy/attachments.json
# CREDENTIALS_DIRECTORY=/run/credentials/galaxy-information-worker.service
# GALAXY_CHAT_CONFIG_FILE=/etc/galaxy/chat.json

# A separate process must not reuse the API's XEP-0114 domain or write secret.
# Its JSON selects a distinct Prosody Component, with the same roomsDomain.
GALAXY_CHAT_CONFIG_FILE=/etc/galaxy/information-chat.json
