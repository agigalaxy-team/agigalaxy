<#ftl output_format="HTML" auto_esc=true>
<#if purpose != "register" && purpose != "reset-password"><#stop "Unsupported account email purpose"></#if>
<#assign actionSuffix = (purpose == "register")?then("Register", "Reset")>
<#import "template.ftl" as layout>
<@layout.emailLayout title=msg("galaxyEmailCodeTitle" + actionSuffix) category=msg("galaxyEmailCodePurpose" + actionSuffix) preheader=msg("galaxyEmailCodePreheader" + actionSuffix, brand) brandName=brand>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
<tr><td style="padding-bottom:18px;"><h1 style="margin:0;font-family:Georgia,'Songti SC','SimSun',serif;font-size:29px;line-height:41px;font-weight:500;color:#29242a;">${msg("galaxyEmailCodeTitle" + actionSuffix)}</h1></td></tr><tr><td style="padding-bottom:26px;"><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26px;color:#605a60;">${msg("galaxyEmailCodeIntroduction" + actionSuffix, brand)}</p><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26px;color:#605a60;">${msg("galaxyEmailCodeInstruction" + actionSuffix)}</p></td></tr><tr><td style=""><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;border-top:1px solid #e7dce3;border-bottom:1px solid #e7dce3;">
<tr><td style="padding:20px 0;vertical-align:middle;"><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26px;color:#605a60;font-size:12px;line-height:20px;color:#8c6f80;">${msg("galaxyEmailCodeCodeLabel")}</p><span dir="ltr" style="display:inline-block;font-family:'SFMono-Regular',Consolas,'Liberation Mono',monospace;font-size:32px;line-height:48px;font-weight:600;letter-spacing:3px;white-space:nowrap;color:#392d36;user-select:all;-webkit-user-select:all;">${code}</span></td><td align="right" width="80" style="padding:20px 0;vertical-align:middle;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:12px;line-height:22px;color:#8b7d86;">${msg("galaxyEmailCodeExpiry", expiresInMinutes?c)}</td></tr>
</table></td></tr><tr><td style="padding-top:23px;"><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26px;color:#605a60;">${msg("galaxyEmailCodeContinuation" + actionSuffix)}</p></td></tr><tr><td style="padding-top:19px;"><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26px;color:#605a60;font-size:12px;line-height:22px;color:#8f858c;">${msg("galaxyEmailCodeSafety")}</p></td></tr>
</table>
</@layout.emailLayout>
