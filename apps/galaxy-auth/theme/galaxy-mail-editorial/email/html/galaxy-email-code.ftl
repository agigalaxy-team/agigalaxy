<#ftl output_format="HTML" auto_esc=true>
<#if purpose != "register" && purpose != "reset-password"><#stop "Unsupported account email purpose"></#if>
<#assign actionSuffix = (purpose == "register")?then("Register", "Reset")>
<#import "template.ftl" as layout>
<@layout.emailLayout title=msg("galaxyEmailCodeTitle" + actionSuffix) category=msg("galaxyEmailCodePurpose" + actionSuffix) preheader=msg("galaxyEmailCodePreheader" + actionSuffix, brand) brandName=brand>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
<tr><td style="padding-bottom:18px;"><h1 class="galaxy-mail-title" style="margin:0;font-family:Georgia,'Songti SC','SimSun',serif;font-size:27px;line-height:39px;font-weight:500;letter-spacing:-.4px;color:#202735;">${msg("galaxyEmailCodeTitle" + actionSuffix)}</h1></td></tr><tr><td style=""><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:25px;color:#495363;">${msg("galaxyEmailCodeIntroduction" + actionSuffix, brand)}</p><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:25px;color:#495363;padding-top:8px;">${msg("galaxyEmailCodeInstruction" + actionSuffix)}</p></td></tr><tr><td style="padding:25px 0 21px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;background-color:#fff5f8;border-left:3px solid #e1b8ca;border-radius:0 4px 4px 0;">
<tr><td class="galaxy-mail-code-cell" style="padding:18px 22px;"><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:25px;color:#495363;font-size:12px;line-height:20px;color:#6e5362;">${msg("galaxyEmailCodeCodeLabel")}</p><span dir="ltr" style="display:block;font-family:'SFMono-Regular',Consolas,'Liberation Mono',monospace;font-size:36px;line-height:54px;font-weight:600;letter-spacing:4px;white-space:nowrap;color:#202735;user-select:all;-webkit-user-select:all;">${code}</span><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:25px;color:#495363;padding-top:1px;font-size:13px;line-height:22px;color:#68717f;">${msg("galaxyEmailCodeExpiry", expiresInMinutes?c)}</p></td></tr>
</table></td></tr><tr><td style=""><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:25px;color:#495363;font-size:12px;line-height:22px;color:#68717f;">${msg("galaxyEmailCodeSafety" + actionSuffix)}</p></td></tr>
</table>
</@layout.emailLayout>
