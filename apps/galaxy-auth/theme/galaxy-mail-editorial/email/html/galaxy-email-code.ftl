<#ftl output_format="HTML" auto_esc=true>
<#if purpose != "register" && purpose != "reset-password"><#stop "Unsupported account email purpose"></#if>
<#assign actionSuffix = (purpose == "register")?then("Register", "Reset")>
<#import "template.ftl" as layout>
<@layout.emailLayout title=msg("galaxyEmailCodeTitle" + actionSuffix) category=msg("galaxyEmailCodePurpose" + actionSuffix) preheader=msg("galaxyEmailCodePreheader" + actionSuffix, brand) brandName=brand>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
<tr><td style="padding-bottom:21px;"><h1 class="galaxy-mail-title" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:24px;line-height:35px;font-weight:600;letter-spacing:-.45px;color:#282a34;">${msg("galaxyEmailCodeTitle" + actionSuffix)}</h1></td></tr><tr><td style=""><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26.25px;color:#505361;">${msg("galaxyEmailCodeIntroduction" + actionSuffix, brand)}</p><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26.25px;color:#505361;padding-top:13px;">${msg("galaxyEmailCodeInstruction" + actionSuffix)}</p></td></tr><tr><td style="padding:23px 0;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;background-color:#fcf5f8;border-left:2px solid #d9b1c5;border-radius:0 4px 4px 0;">
<tr><td class="galaxy-mail-code-cell" style="padding:18px 20px;"><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26.25px;color:#505361;font-size:11.5px;line-height:19px;color:#6d6e7b;">${msg("galaxyEmailCodeCodeLabel")}</p><span dir="ltr" style="display:block;margin:3px 0 4px;font-family:'SFMono-Regular',Consolas,'Liberation Mono',monospace;font-size:33px;line-height:46px;font-weight:600;letter-spacing:3px;white-space:nowrap;color:#282a34;user-select:all;-webkit-user-select:all;">${code}</span><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26.25px;color:#505361;font-size:12px;line-height:20px;color:#6d6e7b;">${msg("galaxyEmailCodeExpiry", expiresInMinutes?c)}</p></td></tr>
</table></td></tr><tr><td style=""><p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;font-size:15px;line-height:26.25px;color:#505361;font-size:12px;line-height:21px;color:#6d6e7b;">${msg("galaxyEmailCodeSafety" + actionSuffix)}</p></td></tr>
</table>
</@layout.emailLayout>
