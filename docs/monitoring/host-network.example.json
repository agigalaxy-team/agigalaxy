{
  "global": {
    "scrape_interval": "30s"
  },
  "scrape_configs": [
    {
      "job_name": "galaxy-host-network",
      "static_configs": [
        {
          "targets": []
        }
      ],
      "metric_relabel_configs": [
        {
          "source_labels": [
            "__name__"
          ],
          "regex": "node_network_(receive|transmit)_(bytes|packets|errs|drop)_total|node_scrape_collector_success",
          "action": "keep"
        }
      ]
    }
  ]
}
