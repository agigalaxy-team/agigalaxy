    {
      "name": "GalaxyExternalProbeFailed",
      "interval": "1m",
      "input_series": [
        {
          "series": "probe_success{job=\"galaxy-external-readiness\",instance=\"https://official.example.org/readyz\",scope=\"api-readiness\"}",
          "values": "0x12 1x28"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "0m",
          "alertname": "GalaxyExternalProbeFailed",
          "exp_alerts": []
        },
        {
          "eval_time": "12m",
          "alertname": "GalaxyExternalProbeFailed",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "galaxy-external-readiness",
                "instance": "https://official.example.org/readyz",
                "scope": "api-readiness",
                "severity": "warning",
                "owner_role": "operations"
              },
              "exp_annotations": {
                "summary": "GalaxyExternalProbeFailed",
                "runbook_ref": "docs/technical/interfaces.md"
              }
            }
          ]
        },
        {
          "eval_time": "35m",
          "alertname": "GalaxyExternalProbeFailed",
          "exp_alerts": []
        }
      ]
    },
