{
  "groups": [
    {
      "name": "galaxy-independent-monitoring",
      "rules": [
        {
          "alert": "GalaxyExternalProbeFailed",
          "expr": "probe_success{job=~\"galaxy-external-.*\"} == 0",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyExternalProbeFailed",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyExternalProbeScrapeFailed",
          "expr": "up{job=~\"galaxy-external-.*\"} == 0",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyExternalProbeScrapeFailed",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyExternalProbeStale",
          "expr": "time() - timestamp(probe_success{job=~\"galaxy-external-.*\"}) > 90",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyExternalProbeStale",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyExternalWebsiteMissing",
          "expr": "absent(up{job=\"galaxy-external-website\"})",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyExternalWebsiteMissing",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyExternalLivenessMissing",
          "expr": "absent(up{job=\"galaxy-external-liveness\"})",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyExternalLivenessMissing",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyExternalReadinessMissing",
          "expr": "absent(up{job=\"galaxy-external-readiness\"})",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyExternalReadinessMissing",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyExternalCertificateExpiring",
          "expr": "(probe_ssl_earliest_cert_expiry{job=~\"galaxy-external-.*\"} - time() < 604800) and on(job,instance,scope) (probe_success{job=~\"galaxy-external-.*\"} == 1)",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyExternalCertificateExpiring",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyMonitorExporterDown",
          "expr": "up{job=\"galaxy-blackbox-exporter\"} == 0",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyMonitorExporterDown",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        },
        {
          "alert": "GalaxyMonitorExporterMissing",
          "expr": "absent(up{job=\"galaxy-blackbox-exporter\"})",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "GalaxyMonitorExporterMissing",
            "runbook_ref": "docs/technical/interfaces.md"
          }
        }
      ]
    }
  ]
}
