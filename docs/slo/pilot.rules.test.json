{
  "rule_files": [
    "pilot.rules.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "GalaxyPilotErrorBudgetFastBurn",
      "interval": "1m",
      "input_series": [
        {
          "series": "galaxy_http_requests_total{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"200\"}",
          "values": "0+90x120 10800+100x480"
        },
        {
          "series": "galaxy_http_requests_total{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"500\"}",
          "values": "0+10x120 1200x480"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "0m",
          "alertname": "GalaxyPilotErrorBudgetFastBurn",
          "exp_alerts": []
        },
        {
          "eval_time": "120m",
          "alertname": "GalaxyPilotErrorBudgetFastBurn",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "galaxy-api",
                "instance": "loopback",
                "component": "api",
                "severity": "critical",
                "owner_role": "operations"
              },
              "exp_annotations": {
                "summary": "Pilot HTTP error budget fast burn",
                "runbook_ref": "docs/pilot-slo-v1.md"
              }
            }
          ]
        },
        {
          "eval_time": "600m",
          "alertname": "GalaxyPilotErrorBudgetFastBurn",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "GalaxyPilotErrorBudgetSlowBurn",
      "interval": "1m",
      "input_series": [
        {
          "series": "galaxy_http_requests_total{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"200\"}",
          "values": "0+90x120 10800+100x480"
        },
        {
          "series": "galaxy_http_requests_total{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"500\"}",
          "values": "0+10x120 1200x480"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "0m",
          "alertname": "GalaxyPilotErrorBudgetSlowBurn",
          "exp_alerts": []
        },
        {
          "eval_time": "120m",
          "alertname": "GalaxyPilotErrorBudgetSlowBurn",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "galaxy-api",
                "instance": "loopback",
                "component": "api",
                "severity": "warning",
                "owner_role": "operations"
              },
              "exp_annotations": {
                "summary": "Pilot HTTP error budget sustained burn",
                "runbook_ref": "docs/pilot-slo-v1.md"
              }
            }
          ]
        },
        {
          "eval_time": "600m",
          "alertname": "GalaxyPilotErrorBudgetSlowBurn",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "GalaxyPilotSuccessfulRequestsSlow",
      "interval": "1m",
      "input_series": [
        {
          "series": "galaxy_http_request_duration_seconds_bucket{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"200\",le=\"1\"}",
          "values": "0+90x20 1800+100x30"
        },
        {
          "series": "galaxy_http_request_duration_seconds_count{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"200\"}",
          "values": "0+100x50"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "0m",
          "alertname": "GalaxyPilotSuccessfulRequestsSlow",
          "exp_alerts": []
        },
        {
          "eval_time": "20m",
          "alertname": "GalaxyPilotSuccessfulRequestsSlow",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "galaxy-api",
                "instance": "loopback",
                "component": "api",
                "severity": "warning",
                "owner_role": "operations"
              },
              "exp_annotations": {
                "summary": "Fewer than95 percent of successful pilot requests complete within1 second",
                "runbook_ref": "docs/pilot-slo-v1.md"
              }
            }
          ]
        },
        {
          "eval_time": "50m",
          "alertname": "GalaxyPilotSuccessfulRequestsSlow",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "No error series yields zero errors; expected denials and probes excluded",
      "interval": "1m",
      "input_series": [
        {
          "series": "galaxy_http_requests_total{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"200\"}",
          "values": "0+100x10"
        },
        {
          "series": "galaxy_http_requests_total{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"POST /v1/cases\",status=\"429\"}",
          "values": "0+1000x10"
        },
        {
          "series": "galaxy_http_requests_total{job=\"galaxy-api\",instance=\"loopback\",component=\"api\",route=\"GET /readyz\",status=\"503\"}",
          "values": "0+1000x10"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "galaxy_slo:http_error_ratio:rate5m",
          "eval_time": "10m",
          "exp_samples": [
            {
              "labels": "galaxy_slo:http_error_ratio:rate5m{component=\"api\",instance=\"loopback\",job=\"galaxy-api\"}",
              "value": 0
            }
          ]
        }
      ]
    }
  ]
}
