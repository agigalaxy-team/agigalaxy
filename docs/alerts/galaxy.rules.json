{
  "groups": [
    {
      "name": "galaxy-operational",
      "interval": "30s",
      "rules": [
        {
          "alert": "GalaxyTargetDown",
          "expr": "up{job=~\"galaxy-api|galaxy-worker\"} == 0",
          "for": "2m",
          "labels": {
            "severity": "critical",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Galaxy metrics target cannot be scraped",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyApiTargetMissing",
          "expr": "absent(up{job=\"galaxy-api\"})",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Expected Galaxy scrape job is missing",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyWorkerTargetMissing",
          "expr": "absent(up{job=\"galaxy-worker\"})",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Expected Galaxy scrape job is missing",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyDatabaseCollectionFailed",
          "expr": "galaxy_database_collection_success == 0 and galaxy_database_collection_enabled == 1",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Database metrics query failed",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyStorageCollectionFailed",
          "expr": "galaxy_storage_collection_success == 0 and galaxy_storage_collection_enabled == 1",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Configured local filesystem metrics unavailable",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyStorageLow",
          "expr": "galaxy_storage_bytes{kind=\"available\"} / ignoring(kind) galaxy_storage_bytes{kind=\"total\"} < 0.1",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Configured local filesystem has less than 10 percent available",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyJobQueueDelayed",
          "expr": "galaxy_job_oldest_open_age_seconds > 300",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Oldest open job has exceeded five minutes",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyQuotaRejections",
          "expr": "increase(galaxy_resource_quota_rejections_total[5m]) > 5",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Resource quota repeatedly rejects growth",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyAuthenticationFailures",
          "expr": "sum by(job,instance,component) (increase(galaxy_http_requests_total{status=~\"401|403\"}[5m])) > 20 and sum by(job,instance,component) (increase(galaxy_http_requests_total{status=~\"401|403\"}[5m])) / sum by(job,instance,component) (increase(galaxy_http_requests_total[5m])) > 0.5",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "identity"
          },
          "annotations": {
            "summary": "Authentication or policy denials exceed volume and ratio thresholds",
            "runbook_ref": "docs/alerting-v1.md#identity"
          }
        },
        {
          "alert": "GalaxyRevocationRequestFailed",
          "expr": "sum by(job,instance,component) (increase(galaxy_http_requests_total{route=~\"POST /v1/.*/revoke\",status=~\"5..\"}[5m])) > 0",
          "for": "1m",
          "labels": {
            "severity": "critical",
            "owner_role": "identity"
          },
          "annotations": {
            "summary": "Revocation HTTP request returned a server error",
            "runbook_ref": "docs/alerting-v1.md#identity"
          }
        },
        {
          "alert": "GalaxyRevocationJobsDelayed",
          "expr": "galaxy_revocation_oldest_open_job_age_seconds > 60 and galaxy_revocation_open_jobs > 0",
          "for": "2m",
          "labels": {
            "severity": "critical",
            "owner_role": "identity"
          },
          "annotations": {
            "summary": "Open work remains after direct Consent or binding revocation",
            "runbook_ref": "docs/alerting-v1.md#identity"
          }
        },
        {
          "alert": "GalaxyRuntimeLogUnavailable",
          "expr": "galaxy_runtime_log_ready == 0",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Runtime diagnostic sink is unavailable",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyRuntimeLogLoss",
          "expr": "increase(galaxy_runtime_log_events{kind=~\"writeFailures|droppedRecords|rotationWarnings\"}[5m]) > 0",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Runtime diagnostics were dropped or failed",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyBackupStatusUnavailable",
          "expr": "galaxy_backup_status_available == 0",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "data"
          },
          "annotations": {
            "summary": "Expected backup status is missing or invalid",
            "runbook_ref": "docs/alerting-v1.md#data"
          }
        },
        {
          "alert": "GalaxyBackupFailed",
          "expr": "galaxy_backup_last_attempt_success == 0",
          "for": "1m",
          "labels": {
            "severity": "critical",
            "owner_role": "data"
          },
          "annotations": {
            "summary": "Latest backup action failed",
            "runbook_ref": "docs/alerting-v1.md#data"
          }
        },
        {
          "alert": "GalaxyBackupStuck",
          "expr": "(time() - galaxy_backup_started_timestamp_seconds > 3600) and galaxy_backup_running == 1",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "data"
          },
          "annotations": {
            "summary": "Backup action has been running for more than one hour",
            "runbook_ref": "docs/alerting-v1.md#data"
          }
        },
        {
          "alert": "GalaxyBackupStale",
          "expr": "(time() - galaxy_backup_last_success_timestamp_seconds{action=\"create\"} > 691200) or (time() - galaxy_backup_last_success_timestamp_seconds{action=\"copy\"} > 86400) or (time() - galaxy_backup_last_success_timestamp_seconds{action=\"check\"} > 604800)",
          "for": "10m",
          "labels": {
            "severity": "warning",
            "owner_role": "data"
          },
          "annotations": {
            "summary": "Scheduled backup success is overdue",
            "runbook_ref": "docs/alerting-v1.md#data"
          }
        },
        {
          "alert": "GalaxyCostBudgetExceeded",
          "expr": "(galaxy_cost_amount > galaxy_cost_budget) and on(job,instance,component) (galaxy_cost_period_start_timestamp_seconds <= time()) and on(job,instance,component) (galaxy_cost_period_end_timestamp_seconds > time())",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Supplied current period cost exceeds its budget",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyCostInputStale",
          "expr": "time() - galaxy_cost_observed_timestamp_seconds > 86400",
          "for": "10m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Optional cost observation is older than one day",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyCostInputUnavailable",
          "expr": "(galaxy_cost_input_available == 0) and (galaxy_cost_collection_enabled == 1)",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Configured cost input is unreadable or invalid",
            "runbook_ref": "docs/alerting-v1.md#operations"
          }
        },
        {
          "alert": "GalaxyRevocationDependencyJobsDelayed",
          "expr": "galaxy_revocation_oldest_dependent_job_age_seconds > 60",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "owner_role": "identity"
          },
          "annotations": {
            "summary": "Revoked ancestor or direct authorization still has open jobs",
            "runbook_ref": "docs/alerting-v1.md#identity"
          }
        },
        {
          "alert": "GalaxyRevocationSearchResidue",
          "expr": "galaxy_revocation_search_documents > 0",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "owner_role": "identity"
          },
          "annotations": {
            "summary": "Search candidates still reference revoked authorization",
            "runbook_ref": "docs/alerting-v1.md#identity"
          }
        },
        {
          "alert": "GalaxyAutonomyCollectionFailed",
          "expr": "galaxy_autonomy_collection_success{component=\"api\"} == 0",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Independent duty metadata collection is unavailable",
            "runbook_ref": "docs/ai-autonomy-runtime.md"
          }
        },
        {
          "alert": "GalaxyAutonomyWorkerStale",
          "expr": "((galaxy_autonomy_worker_tick_age_seconds{component=\"api\"} > galaxy_autonomy_worker_tick_limit_seconds{component=\"api\"}) or (galaxy_autonomy_worker_health_available{component=\"api\"} == 0)) and (galaxy_autonomy_enabled_accounts{component=\"api\"} > 0)",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Enabled duty scheduler has no current independent heartbeat",
            "runbook_ref": "docs/ai-autonomy-runtime.md"
          }
        },
        {
          "alert": "GalaxyAutonomyTasksOverdue",
          "expr": "(galaxy_autonomy_overdue_start_tasks{component=\"api\"} > 0) or (galaxy_autonomy_overdue_round_tasks{component=\"api\"} > 0)",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "owner_role": "operations"
          },
          "annotations": {
            "summary": "Persisted duty work exceeded its start or round allowance",
            "runbook_ref": "docs/ai-autonomy-runtime.md"
          }
        }
      ]
    }
  ]
}
